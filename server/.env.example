# Copy this file to ".env" and fill it in. Never share or commit ".env".

PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:YOUR_PG_PASSWORD@localhost:5432/portfolio

# Any long random text (32+ characters). It signs admin login tokens.
JWT_SECRET=change-this-to-a-long-random-text-32-chars-minimum

# AI chat (optional). Get a key at https://console.anthropic.com  (API billing is separate from a claude.ai plan).
# Leave empty and the chat still works, but answers from your portfolio data without AI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Only on Vercel (set these in Project Settings > Environment Variables) ----
# First admin account, created on the first deploy if none exists yet.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# Added automatically when you connect a Vercel Blob store (image and resume uploads).
# BLOB_READ_WRITE_TOKEN=
